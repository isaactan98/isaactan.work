# Anything the build does not need. Keeping this tight matters twice over: it
# shrinks the context uploaded to the daemon, and it stops a stale local
# .output or node_modules from being copied in over the one just built.

.git
.github
.gitignore

node_modules
.output
.nuxt
.nitro
.data
.cache
dist

*.log
logs

.env
.env.*
!.env.example

.DS_Store
.idea
.fleet
.vscode

# Documentation and deployment descriptors play no part in the image.
README.md
compose.yml
Dockerfile
.dockerignore
